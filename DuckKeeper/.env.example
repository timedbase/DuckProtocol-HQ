# RPC per chain -- used to read pool/vault/token state and submit the
# keeper's transactions. Optional: each falls back to the chain's public RPC,
# but set dedicated endpoints in production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
INK_RPC_URL=https://rpc-gel.inkonchain.com

# Optional -- each chain defaults to the "current" Goldsky tag of its own
# subgraph (duck-subgraph-rh / duck-subgraph-ink), same as the backend.
# ROBINHOOD_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmhtxnzpqm81001w94ksmgira/subgraphs/duck-subgraph-rh/current/gn
# INK_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmhtxnzpqm81001w94ksmgira/subgraphs/duck-subgraph-ink/current/gn

# Optional -- comma-separated chain slugs to run (default: robinhood,ink).
# KEEPER_CHAINS=robinhood,ink

# DuckKeeper's own operating wallet -- a plain EOA private key, funded with
# gas on every chain it runs. It holds NO special role in any contract:
# claimFees, processBatch and triggerBuyback are permissionless, the keeper is
# just the one reliably calling them. (claimFees pays its caller 1% of the
# claimed fee when the caller isn't the pool's creator, which offsets gas.)
# Never reuse the protocol owner/deployer key here.
KEEPER_PRIVATE_KEY=0x...

# Logs what each pass WOULD do without submitting any transactions.
# DRY_RUN=true
