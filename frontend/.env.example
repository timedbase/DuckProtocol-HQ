# Points at a real, reachable backend -- there is no demo/canned-data mode
# anymore. Leave unset to use the real deployed backend (api.duckfun.family,
# hardcoded as api.js's default); set this only to run against a backend
# started locally instead (see ../backend/README.md).
VITE_API_URL=http://localhost:3000

# RainbowKit's WalletConnect connector needs a project id -- free account at
# https://cloud.reown.com. Injected wallets (MetaMask, Rabby, etc.) work
# without one; only the WalletConnect option in the connect modal needs it.
VITE_WALLETCONNECT_PROJECT_ID=
