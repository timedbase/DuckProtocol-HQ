# Must point at a real, reachable backend -- there is no demo/canned-data
# mode anymore. localhost:3000 is only useful when running that backend
# locally too (see ../backend/README.md); a deployed frontend needs this
# set to that deployment's real URL (e.g. the Render service render.yaml
# provisions).
VITE_API_URL=http://localhost:3000

# RainbowKit's WalletConnect connector needs a project id -- free account at
# https://cloud.reown.com. Injected wallets (MetaMask, Rabby, etc.) work
# without one; only the WalletConnect option in the connect modal needs it.
VITE_WALLETCONNECT_PROJECT_ID=
