# RPC per chain. Optional -- each falls back to the chain's public RPC
# (see src/chain/addresses.ts), but set dedicated endpoints in production.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
INK_RPC_URL=https://rpc-gel.inkonchain.com

# Optional -- each chain defaults to the "current" Goldsky tag of its own
# subgraph (duck-subgraph-rh / duck-subgraph-ink), so a subgraph redeploy
# never needs these touched. Set only to pin a version or use another indexer.
# ROBINHOOD_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmhtxnzpqm81001w94ksmgira/subgraphs/duck-subgraph-rh/current/gn
# INK_SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmhtxnzpqm81001w94ksmgira/subgraphs/duck-subgraph-ink/current/gn

# API
PORT=3000

# Token-create image/metadata uploads (pinata.cloud API JWT) — server-side
# only, never sent to the browser.
PINATA_JWT=your-pinata-jwt

# Backs persisted token comments/chat (backend/src/db). Optional: missing it
# just leaves comments 503ing, not the whole API down.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# The platform's own token ($DUCK) per chain -- the ONLY token the API ever
# marks `verified: true` on that chain (see api/routes/tokens.ts). Leave
# unset until $DUCK launches there.
ROBINHOOD_DUCK_TOKEN_ADDRESS=
INK_DUCK_TOKEN_ADDRESS=
