# Real RPC for Robinhood Chain (chain id 4663). Required -- there's no
# fallback baked in (see chain/client.ts), so any route touching RPC 502s
# without it.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional -- subgraph/client.js already defaults this to the "current" tag
# of the deployed duck-protocol-rh Goldsky subgraph, so a redeploy never
# needs this touched. Only set to pin a specific version or point at a
# different indexer.
# SUBGRAPH_URL=https://api.goldsky.com/api/public/project_cmhtxnzpqm81001w94ksmgira/subgraphs/duck-protocol-rh/current/gn

# API
PORT=3000

# Token-create image/metadata uploads (pinata.cloud API JWT) — server-side
# only, never sent to the browser.
PINATA_JWT=your-pinata-jwt

# Backs persisted token comments/chat (backend/src/db) -- nothing else in
# the API uses this; every other read stays subgraph/RPC-sourced. Optional:
# missing it just leaves comments 503ing, not the whole API down.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# The platform's own token ($DUCK) -- the ONLY token the API ever marks
# `verified: true` on (see api/routes/tokens.ts). Deliberately a plain env
# var, not an on-chain read or a curated list: there is exactly one verified
# token, ever, and it's a deploy-time fact, not something that changes at
# runtime. Unset until $DUCK actually launches -- no token is verified until
# a real address is configured here.
DUCK_TOKEN_ADDRESS=
